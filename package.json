{
  "name": "dsh-acceptance-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Feature-coverage acceptance fixture repository for dsh-maintainer-workbench",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"projects/ts-monorepo/packages/*/test/**/*.test.ts\"",
    "test:node-app": "node --test \"projects/node-ts-app/test/**/*.test.js\"",
    "test:python": "python -m unittest discover -s projects/python-lib/tests -v",
    "test:rust": "cargo test --manifest-path projects/rust-cli/Cargo.toml",
    "bootstrap": "node --use-system-ca scripts/seed.mjs bootstrap",
    "seed": "node --use-system-ca scripts/seed.mjs all",
    "seed:followup": "node --use-system-ca scripts/seed.mjs followup",
    "seed:secondary": "node --use-system-ca scripts/seed.mjs secondary",
    "status": "node --use-system-ca scripts/status.mjs",
    "cleanup": "node --use-system-ca scripts/cleanup.mjs"
  }
}
