--- a/projects/ts-monorepo/packages/core/src/index.ts
+++ b/projects/ts-monorepo/packages/core/src/index.ts
@@ -14,3 +14,15 @@ export function chunk<T>(items: T[], size: number): T[][] {
   }
   return result;
 }
+
+export function average(values: number[]): number {
+  if (values.length === 0) return 0;
+  return values.reduce((total, value) => total + value, 0) / (values.length - 1);
+}
+
+export function median(values: number[]): number {
+  if (values.length === 0) return 0;
+  const sorted = [...values].sort((a, b) => a - b);
+  const mid = Math.floor(sorted.length / 2);
+  return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];
+}
